# Valores locais seguros; nunca copie segredos reais para este arquivo.
# Em produção, cadastre cada valor no cofre de segredos da plataforma.

PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=generate-a-long-random-secret-outside-version-control
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
LOG_LEVEL=info

# O chat fica desligado por padrão. Para ativá-lo em produção, preencha todos
# os valores abaixo diretamente na plataforma de deploy.
CHAT_ENABLED=false
CHAT_SESSION_TTL_SECONDS=1800
CHAT_MAX_MESSAGES=20
CHAT_MAX_MESSAGE_BYTES=8192
CHAT_MAX_REQUEST_BYTES=65536
CHAT_MAX_OUTPUT_TOKENS=1000
CHAT_TIMEOUT_MS=90000

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# SYSTEM_PROMPT=Contexto factual adicional sobre Wendell; a política comercial base é aplicada pelo Relay.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=
# TURNSTILE_EXPECTED_ACTION=

# Entrega de oportunidades. Crie um formulário no Formspree e configure o
# destinatário no painel do serviço antes de ativar.
LEAD_DELIVERY_ENABLED=false
# FORMSPREE_FORM_ENDPOINT=https://formspree.io/f/SEU_ID
